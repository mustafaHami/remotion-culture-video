{
  "name": "remotion-culture-video",
  "version": "0.1.0",
  "private": true,
  "description": "Vidéos verticales courtes de culture générale en univers voxel (Remotion + Three.js).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3000",
    "browser": "remotion browser ensure",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "verify": "node scripts/check-project.cjs && node scripts/sync-skills.cjs --check",
    "skills:sync": "node scripts/sync-skills.cjs",
    "render": "node scripts/render.cjs",
    "stills": "node scripts/render-stills.cjs",
    "essai:render": "node scripts/render.cjs --compositions=EssaiStyleA,EssaiStyleB,EssaiStyleD --out=output/essais"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/three": "4.0.534",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.534",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
