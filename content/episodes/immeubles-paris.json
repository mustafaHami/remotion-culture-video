  "sources": [
    {
      "fact": "Décret du 27 juillet 1859 : dans les rues de plus de 20 m de largeur, la hauteur des façades peut être portée à 20 m (sans dépasser 5 étages carrés au-dessus du rez-de-chaussée) ; couvertures inclinées à 45°.",
      "title": "Règlement et tissus urbains de Paris (applan 71), APUR, 1971, p. 3 et p. 8",
      "url": "https://50ans.apur.org/data/b4s3_home/fiche/75/03_reglement_tissus_urbains_paris_applan71_fd3ab.pdf",
      "consulted": "2026-10-25"
    },
    {
      "fact": "Règlement du 27 juillet 1859 : « Dans les rues de plus de 20 mètres de largeur, les façades peuvent désormais atteindre 20 mètres de hauteur. Les combles restent limités par une diagonale à 45 degrés. »",
      "title": "Règlements d'urbanisme de Paris, Wikipédia (français)",
      "url": "https://fr.wikipedia.org/wiki/R%C3%A8glements_d%27urbanisme_de_Paris",
      "consulted": "2026-10-25"
    },
    {
      "fact": "Le règlement de 1859 autorise un cinquième étage carré sur les voies larges de plus de vingt mètres (gabarit : soubassement, cinq étages, comble brisé).",
      "title": "Anne Richard-Bazire, « Les immeubles », Livraisons de l'histoire de l'architecture, 36, 2018, p. 103-121",
      "url": "https://journals.openedition.org/lha/1036",
      "consulted": "2026-10-25"
    },
    {
      "fact": "Lors de la vente des terrains, Haussmann impose par cahier des charges, pour chaque îlot, les mêmes hauteurs d'étage et les mêmes lignes principales de façade, avec balcons, corniches et moulures ; il n'existe pas de règlement plus précis de l'immeuble « haussmannien ».",
      "title": "« Haussmann Georges Eugène, baron (1809-1891) », Encyclopædia Universalis, partie 4 « L'œuvre accomplie »",
      "url": "https://www.universalis.fr/encyclopedie/georges-eugene-haussmann/4-l-oeuvre-accomplie/",
      "consulted": "2026-10-25"
    },
    {
      "fact": "Haussmann recommande qu'au sein d'un même îlot, les lignes des balcons et des séparations d'étages forment des lignes continues d'un immeuble à l'autre.",
      "title": "Règlements d'urbanisme de Paris, Wikipédia (français)",
      "url": "https://fr.wikipedia.org/wiki/R%C3%A8glements_d%27urbanisme_de_Paris",
      "consulted": "2026-10-25"
    }
  ],
